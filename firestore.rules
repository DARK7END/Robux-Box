rules_version = '2';

// =============================================================================
// Robux Box — Firestore Security Rules
// =============================================================================
// Security model:
//   * The economy is server-authoritative. Clients can NEVER write balances,
//     transactions, redemptions status, tiers, VIP or fraud data — only Cloud
//     Functions (running with the Admin SDK, which bypasses these rules) may.
//   * Clients get read access only to their own data and to public catalogue
//     collections (rewards, offers, banners, leaderboards).
//   * A custom claim `admin == true` (set by a Cloud Function) unlocks the admin
//     dashboard collections.
//   * App Check is enforced at the API layer; these rules add row-level
//     authorization on top.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------- Helpers ---------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    // True only for changes coming through the Admin SDK (Cloud Functions),
    // which are exempt from rules; used to make client-write intent explicit.
    function clientCannotWrite() {
      return false;
    }

    // ------------------------------ Users ----------------------------------
    // Profile is readable by owner + admins. Clients may update ONLY a safe
    // allow-list of profile fields; everything economic is function-only.
    match /users/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow create: if isUser(uid)
                    && request.resource.data.keys().hasOnly([
                         'displayName','photoUrl','locale','robloxUsername',
                         'referredBy','createdAt','lastActiveAt','email',
                         'phoneNumber'
                       ]);
      allow update: if (isUser(uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'displayName','photoUrl','locale','robloxUsername',
                           'lastActiveAt'
                         ]))
                    || isAdmin();
      allow delete: if isAdmin();

      // Private per-user subcollections (function-written, owner-readable).
      match /transactions/{txId} {
        allow read: if isUser(uid) || isAdmin();
        allow write: if clientCannotWrite();
      }
      match /notifications/{nId} {
        allow read: if isUser(uid) || isAdmin();
        // Owner may only flip isRead; content is function-written.
        allow update: if isUser(uid)
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['isRead']);
        allow create, delete: if clientCannotWrite();
      }
      match /devices/{deviceId} {
        allow read: if isUser(uid) || isAdmin();
        // Client may register/refresh its own FCM token + device metadata.
        allow write: if isUser(uid);
      }
      match /achievements/{aId} {
        allow read: if isUser(uid) || isAdmin();
        allow write: if clientCannotWrite();
      }
    }

    // ----------------------------- Wallets ---------------------------------
    // Strictly read-only for the owner; only Cloud Functions mutate balances.
    match /wallets/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow write: if clientCannotWrite();
    }

    // ------------------------- Public catalogues ---------------------------
    match /rewards/{rewardId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /banners/{bannerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --------------------------- Leaderboards ------------------------------
    match /leaderboards/{period} {
      allow read: if isSignedIn();
      allow write: if clientCannotWrite();
      match /entries/{uid} {
        allow read: if isSignedIn();
        allow write: if clientCannotWrite();
      }
    }

    // ---------------------------- Redemptions ------------------------------
    // Created + transitioned only by functions/admins; owner can read own.
    match /redemptions/{redemptionId} {
      allow read: if isSignedIn()
                  && (isAdmin() || resource.data.uid == request.auth.uid);
      allow write: if isAdmin() || clientCannotWrite();
    }

    // ---------------------------- Promocodes -------------------------------
    // Never client-readable (would leak valid codes); redeemed via function.
    match /promocodes/{code} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ------------------------------ Config ---------------------------------
    // Read-only remote config (economy, tiers, feature flags, maintenance).
    // `notifications` is excluded — it holds admin contact emails, which are
    // server-side-only (read by Cloud Functions via the Admin SDK, which
    // bypasses these rules entirely) and must never be client-readable.
    match /config/{doc} {
      allow read: if isSignedIn() && doc != 'notifications';
      allow write: if isAdmin();
    }
    match /geo_tiers/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --------------------- Admin-only / internal ---------------------------
    match /transactions/{txId}        { allow read, write: if isAdmin(); }
    match /offer_completions/{id}     { allow read, write: if isAdmin(); }
    match /ad_impressions/{id}        { allow read, write: if isAdmin(); }
    match /vip_purchases/{id}         { allow read, write: if isAdmin(); }
    match /fraud_flags/{id}           { allow read, write: if isAdmin(); }
    match /audit_logs/{id}            { allow read: if isAdmin();
                                        allow write: if clientCannotWrite(); }
    match /referrals/{id} {
      allow read: if isSignedIn()
                  && (isAdmin()
                      || resource.data.referrerUid == request.auth.uid
                      || resource.data.refereeUid == request.auth.uid);
      allow write: if clientCannotWrite();
    }
    match /devices/{id}               { allow read, write: if isAdmin(); }

    // Admin registry + analytics rollup — readable by admins, written only by
    // Cloud Functions (setAdminClaim / computeAnalytics via the Admin SDK).
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if clientCannotWrite();
    }
    match /analytics/{doc} {
      allow read: if isAdmin();
      allow write: if clientCannotWrite();
    }

    // ------------------------------ Reports --------------------------------
    // Users can file a report; only admins can read/triage.
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // -------------------------- Support Tickets -----------------------------
    // A user can open a ticket and read/reply to their own; admins can read,
    // reply to and manage the status of every ticket. Non-economic, so — like
    // rewards — writes go straight through rules rather than a Cloud Function.
    match /supportTickets/{ticketId} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'open';
      allow read: if isUser(resource.data.uid) || isAdmin();
      // Sending a message updates updatedAt/lastMessagePreview/status in the
      // same batch as the message write; the owner may only ever flip their
      // own ticket's status, never touch anything else.
      allow update: if isAdmin()
                    || (isUser(resource.data.uid)
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'updatedAt', 'lastMessagePreview', 'lastSenderIsAdmin'])
                        && (request.resource.data.status == 'open'
                            || request.resource.data.status == 'closed'));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function ticketOwnerUid() {
          return get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid;
        }
        allow create: if (isUser(ticketOwnerUid()) || isAdmin())
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.isAdmin == isAdmin();
        allow read: if isUser(ticketOwnerUid()) || isAdmin();
        // Immutable — a message is never edited after the fact — but an
        // admin deleting the whole ticket (SupportRepository.deleteTicket)
        // needs to clear its messages too.
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Default deny — anything not matched above is inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

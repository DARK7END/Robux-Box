# Signing secrets — NEVER commit these.
android/key.properties
android/app/upload-keystore.jks
android/app/*.jks
*.keystore
# google-services.json holds non-secret client identifiers (same key as
# firebase_options.dart) and is committed so the Android build works out of the
# box. Remove this project's file and gitignore it again if the repo is public.

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
**/GoogleService-Info.plist

# Firebase — firebase_options.dart holds non-secret client identifiers and is
# committed as a template; regenerate it per-project with `flutterfire configure`.
.firebaserc
functions/node_modules/
functions/lib/
functions/.env
functions/*.log
.runtimeconfig.json
firebase-debug.log
firestore-debug.log
ui-debug.log

# Secrets / env
.env
.env.*
!.env.example
*.pem
*.p8
serviceAccountKey.json

# Coverage / test
coverage/
test/.test_coverage.dart

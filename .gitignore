# Android
android/.gradle/
android/captures/
android/local.properties
# Signing secrets — NEVER commit these.
android/key.properties
android/app/upload-keystore.jks
android/app/*.jks
*.keystore
# google-services.json holds non-secret client identifiers (same key as
# firebase_options.dart) and is committed so the Android build works out of the
# box. Remove this project's file and gitignore it again if the repo is public.

# iOS — the Xcode project is GENERATED by `tool/setup_ios.sh` (flutter create +
# overlay from ios_config/), so it is not committed. The canonical config lives
# in ios_config/.
/ios/

# Web — this app is Android/iOS only (several plugins, e.g. google_mobile_ads,
# have no real web implementation). `flutter create --platforms=web .`
# regenerates this on demand purely for local UI verification in a browser;
# it is never a shipped target, same reasoning as /ios/ above.
/web/
**/GoogleService-Info.plist
!ios_config/GoogleService-Info.plist

# Firebase — firebase_options.dart holds non-secret client identifiers and is
# committed as a template; regenerate it per-project with `flutterfire configure`.
.firebaserc
functions/node_modules/
functions/lib/
functions/.env
functions/*.log
.runtimeconfig.json
firebase-debug.log
firestore-debug.log
ui-debug.log

# Secrets / env
.env
.env.*
!.env.example
*.pem
*.p8
serviceAccountKey.json

# Coverage / test
coverage/
test/.test_coverage.dart

# Python cache
__pycache__/
*.pyc

	<string>ca-app-pub-3940256099942544~1458002511</string>

	<!-- Permission usage strings (required or the app is rejected/crashes on request). -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Robux Box uses your activity to verify completed offers and pay out your rewards.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Robux Box uses your location to determine your rewards tier so you earn the correct amount.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Robux Box needs photo library access so you can choose a profile picture.</string>
	<key>NSCameraUsageDescription</key>
	<string>Robux Box needs camera access so you can take a profile picture.</string>

	<!-- FCM / background work. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>FirebaseAppDelegateProxyEnabled</key>
	<true/>

	<!-- SKAdNetwork (AdMob attribution). -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>

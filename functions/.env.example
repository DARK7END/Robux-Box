# Cloud Functions environment configuration.
# Copy to functions/.env (gitignored) and fill in real values, or set these as
# secrets with `firebase functions:secrets:set` for production.

# Offerwall provider (e.g. AdGate, BitLabs, OfferToro)
OFFERWALL_BASE_URL=https://wall.yourprovider.com/wall
OFFERWALL_APP_ID=your_offerwall_app_id
OFFERWALL_SECRET=your_offerwall_postback_secret

# Require the AdMob SSV record before crediting a rewarded ad (recommended: true)
STRICT_SSV=false

# Comma-separated emails allowed to bootstrap the first admin claim.
ADMIN_BOOTSTRAP_EMAIL=you@example.com
